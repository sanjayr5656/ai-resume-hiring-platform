# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sensitive Environment Variables & Secrets
.env
.env.*
!.env.example
*.env

# Uploaded candidate files and documents
uploads/resumes/*
!uploads/resumes/.gitkeep
uploads/proofs/*
!uploads/proofs/.gitkeep
uploads/profiles/*
!uploads/profiles/.gitkeep

# Data reset backups (created by npm run reset:data)
backups/

# Debug / scratch dumps
scripts/*.html


# Frontend Build artifacts
dist/
build/

# Temporary / Editor files / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log